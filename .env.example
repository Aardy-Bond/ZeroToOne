# Copy to .env and fill in your own values. Never commit the real .env.

# --- Databricks ---
# Workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST="https://<your-workspace>.cloud.databricks.com"

# Authentication is handled by the Databricks CLI OAuth profile in
# ~/.databrickscfg (run `databricks auth login --host $DATABRICKS_HOST`).
# Only set a PAT here if you are not using a CLI profile.
# DATABRICKS_TOKEN=""

# SQL warehouse used by the Lore Engine. Optional — the first running
# warehouse is auto-selected when this is unset.
# DATABRICKS_WAREHOUSE_ID=""

# --- OpenAI ---
# Used for embeddings (text-embedding-3-small), critique and rewrites
# (gpt-4o), and scratch audio (tts-1-hd).
OPENAI_API_KEY="sk-..."
